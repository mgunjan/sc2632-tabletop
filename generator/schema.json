{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuardrailSpec",
  "description": "What the model is allowed to say. The model fills this; deterministic templates turn it into Kyverno policies. The model never writes YAML. Every string that reaches a CEL expression has a strict pattern: model output is untrusted input to the policy compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "clauses",
    "controls",
    "exceptions",
    "rollout"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "The namespace the intent is about."
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "control"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "maxLength": 500
          },
          "control": {
            "type": "string",
            "enum": [
              "egress_profile",
              "deny_privilege_escalation",
              "restrict_registry",
              "restrict_api_access",
              "deny_sa_token_for_agent_sidecars",
              "deny_agent_mutation_outside_namespace",
              "require_ticket_on_agent_changes",
              "audit_replica_surge",
              "not_implementable"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "egress_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "approved_profiles",
            "in_intent"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "approved_profiles": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "minItems": 1
            },
            "in_intent": {
              "type": "boolean"
            }
          }
        },
        "deny_privilege_escalation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "in_intent"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "in_intent": {
              "type": "boolean"
            }
          }
        },
        "restrict_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "registry",
            "in_intent"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "registry": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?(:[0-9]{1,5})?(/[a-z0-9._-]+)*$"
            },
            "in_intent": {
              "type": "boolean"
            }
          }
        },
        "restrict_api_access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "in_intent"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "in_intent": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "deny_sa_token_for_agent_sidecars": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "in_intent"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "in_intent": {
              "type": "boolean"
            },
            "sidecar_label": {
              "type": "string",
              "default": "trustfall.example/agent-sidecar",
              "pattern": "^([a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?/)?[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$"
            }
          }
        },
        "deny_agent_mutation_outside_namespace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "in_intent",
            "agent_serviceaccount",
            "home_namespace"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "in_intent": {
              "type": "boolean"
            },
            "agent_serviceaccount": {
              "type": "string",
              "pattern": "^system:serviceaccount:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "home_namespace": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
            }
          }
        },
        "require_ticket_on_agent_changes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "in_intent",
            "agent_serviceaccount"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "in_intent": {
              "type": "boolean"
            },
            "agent_serviceaccount": {
              "type": "string",
              "pattern": "^system:serviceaccount:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "annotation": {
              "type": "string",
              "default": "trustfall.example/ticket",
              "pattern": "^([a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?/)?[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$"
            }
          }
        },
        "audit_replica_surge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "in_intent",
            "threshold"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "in_intent": {
              "type": "boolean"
            },
            "threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workload",
          "control",
          "owner",
          "ttl_hours",
          "reason"
        ],
        "properties": {
          "workload": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "control": {
            "type": "string",
            "enum": [
              "egress_profile",
              "deny_privilege_escalation",
              "restrict_registry",
              "deny_sa_token_for_agent_sidecars",
              "deny_agent_mutation_outside_namespace",
              "require_ticket_on_agent_changes"
            ]
          },
          "owner": {
            "type": "string",
            "maxLength": 200
          },
          "ttl_hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 720
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "rollout": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Audit",
          "Warn",
          "Deny"
        ]
      },
      "minItems": 1
    }
  }
}
