{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "collector-new",
        "namespace": "sc2632-d-observe-662ff0ad",
        "labels": {
          "app": "case-d-collector",
          "sc2632.example/suspect": "false"
        }
      },
      "spec": {
        "serviceAccountName": "collector",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "http",
            "image": "registry.trustfall.internal/platform/lab-target:1",
            "imagePullPolicy": "IfNotPresent",
            "readinessProbe": {
              "tcpSocket": {
                "port": 8080
              },
              "periodSeconds": 1
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "privileged": false,
              "runAsNonRoot": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            }
          }
        ]
      }
    }
  ]
}
